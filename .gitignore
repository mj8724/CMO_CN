# CMO 汉化工程 — 构建产物
build/
out/
*.dll
*.exe
*.pdb
*.zip

# 证据与截图（体积大，不纳入版本库）
evidence/
*.png
*.jpg
# 例外：需要随仓库发布的图片（README 里直接引用的社区/捐赠图）
!assets/community/*.png

# 运行时日志与临时文件
*.log
__pycache__/
*.pyc
*.tmp
*.bak
*.orig

# 游戏运行时解析产物
CMOLocalizer.log

# 编辑器
.vs/
.idea/
*.user

# 生成物（可重现）
dict/worklist.json
dict/CMOLocalizer.json.bak

# maestro runtime lock/state (live process 6648)
.workflow/search-daemon.json
.workflow/wiki-index-publisher.lock

# 数据库描述正文翻译流水线的中间产物（可由 scripts/db_desc_work.py 重现）
dict/db_desc_work.json
dict/db_desc_chunks/
dict/db_desc_out/

# 会话/恢复归档绝不入库（含凭证风险）
.workflow/recovery/
.workflow/sessions/
.workflow/**/session-*.md
scripts/translate_worker.py

# 凭据与私有配置（绝不入库）
.env
.env.*
.secrets.local.json
secrets/
*.secrets.json
*.pem
*.key
